FROM 326954429656.dkr.ecr.eu-west-1.amazonaws.com/golden-images/node:24.22.1-trixie-slim-swan.3 AS builder
WORKDIR /app
ADD ./server/ ./
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g pnpm@latest-10
RUN pnpm install --no-frozen-lockfile

FROM 326954429656.dkr.ecr.eu-west-1.amazonaws.com/golden-images/node:24.22.1-trixie-slim-swan.3
WORKDIR /app
COPY --chown=node:node --from=builder /app ./
CMD ["npm", "run", "start-swan"]
EXPOSE 8080
