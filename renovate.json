{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(build)"],
  "enabledManagers": ["dockerfile", "custom.regex"],
  "ignorePresets": ["workarounds:nodeDockerVersioning"],
  "labels": ["dependencies", "bot"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Node of .nvmrc (CI, local dev) is the Node of the golden image: same tag, same PR",
      "managerFilePatterns": ["/^\\.nvmrc$/"],
      "matchStrings": ["^v?(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "326954429656.dkr.ecr.eu-west-1.amazonaws.com/golden-images/node",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)-trixie-slim-swan\\.\\d+$"
    }
  ],
  "packageRules": [
    {
      "description": "Swan golden images: <node>-<variant>-swan.N — the variant is fixed, N and the node version move",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "326954429656.dkr.ecr.eu-west-1.amazonaws.com/golden-images/**"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>.+)-swan\\.(?<build>\\d+)$",
      "groupName": "Swan golden images",
      "separateMinorPatch": true
    },
    {
      "description": "Only the golden images are managed here. Other FROM lines (the public Dockerfile's upstream node, test fixtures) are left alone.",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "!326954429656.dkr.ecr.eu-west-1.amazonaws.com/golden-images/**"
      ],
      "enabled": false
    },
    {
      "description": ".nvmrc holds a plain Node version extracted from the golden image tag",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".nvmrc"],
      "versioning": "node"
    }
  ]
}
